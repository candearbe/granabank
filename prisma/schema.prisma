
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Movement {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  amount      Decimal      @db.Decimal(12, 2)
  type        MovementType
  createdAt   DateTime     @default(now())
}

enum MovementType {
  SUBSCRIPTION
  RECEIVED
  SENT
}
